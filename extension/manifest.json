{
  "manifest_version": 3,
  "name": "Ninebark for RStudio",
  "version": "1.0.0",
  "description": "Type R commands in plain English right on RStudio Server, Posit Workbench, or Posit Cloud — no setup, works on the real page.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://posit.cloud/*",
        "https://rstudio.cloud/*"
      ],
      "js": ["dist/rstudio.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://posit.cloud/*",
    "https://rstudio.cloud/*"
  ]
}
